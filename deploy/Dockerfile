# Образ сервісу. Той самий для API й для планувальника — різниця лише в команді.
#
# Без multi-stage навмисно: тут немає ні компіляції, ні збірки фронтенду, і другий етап
# заощадив би десяток мегабайт ціною файлу, який доводиться читати двічі.

FROM python:3.12-slim

# Не писати .pyc і не буферизувати вивід: у контейнері лог має зʼявлятись одразу, інакше
# «сервіс мовчить» і «сервіс завис» виглядають однаково.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Спершу лише маніфест: шар із залежностями перебудовується тоді, коли міняються
# залежності, а не тоді, коли міняється рядок коду.
COPY pyproject.toml README.md ./
COPY shared/ shared/
RUN pip install --no-cache-dir -e ".[s06]"

COPY stages/ stages/
COPY migrations/ migrations/
COPY scripts/ scripts/

# Не root. Процес, що читає недовірений вхід, не має права писати у власний образ.
#
# Каталог тому створюється ТУТ і з правильним власником. Docker переносить права з
# образу у свіжий іменований том при першому монтуванні; без цього рядка том належить
# root, процес під uid 10001 отримує PermissionError на першому ж записі трейсу, а
# проксі віддає 502. Знайти це можна лише справжнім розгортанням: локально каталог
# належить тому, хто запустив.
# `/app` лишається за root і доступний лише на читання: користувач, що виконує код,
# не має права його переписати. Перша редакція робила `chown -R agentic /app` — і
# заявлена властивість не виконувалась: будь-яка вада десеріалізації ставала
# персистентною, бо `restart: unless-stopped` підхоплював переписаний модуль.
#
# `/data` — єдине, що справді потребує запису.
RUN useradd --create-home --uid 10001 agentic \
    && mkdir -p /data/traces \
    && chown -R agentic /data \
    && chmod -R a-w /app
USER agentic

EXPOSE 8000
CMD ["uvicorn", "stages.s06_platform.serve:app", "--host", "0.0.0.0", "--port", "8000"]
