# TLS, перенаправлення й єдиний вхід. Сервіс про HTTPS не знає нічого — і це навмисно
# (ADR-0007): застосунок, що вміє TLS, доводиться перезапускати на кожне оновлення
# сертифіката, а сертифікати оновлюються самі лише тоді, коли їх ніхто не тримає в руках.
#
# Той самий файл працює локально й на домені. Різниця — одна змінна оточення:
#
#   SITE_ADDRESS=localhost          локально: внутрішній сертифікат, довіри ззовні немає
#   SITE_ADDRESS=agentic.example    на домені: сертифікат від публічного центру
#
# Саме тому `smoke.sh` виконує ОДИН перелік проти обох цілей: механіка та сама, і
# неперевіреним лишається рівно одне — довіра до сертифіката (spec AC-08).

{
	# Пошта для повідомлень центру сертифікації. Локально не використовується.
	email {$ACME_EMAIL:admin@example.com}
	# Локально Caddy бере внутрішній центр; на домені рядок нижче не діє.
	auto_https disable_redirects
}

{$SITE_ADDRESS:localhost} {
	encode gzip

	# Заголовки безпеки: два рядки замість бібліотеки.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000 {
		# Сервіс має знати, ким був запит НАСПРАВДІ: за проксі всі адреси однакові,
		# і ліміт частоти без цього рахував би проксі як єдиного клієнта.
		header_up X-Forwarded-For {remote_host}
	}
}

# Незашифроване зʼєднання перенаправляється на захищене (AC-08). Окремий блок, бо
# `auto_https disable_redirects` вимкнув автоматичний — інакше локально Caddy
# перенаправляв би на порт, якого в збірці немає.
http://{$SITE_ADDRESS:localhost} {
	redir https://{host}{uri} permanent
}
