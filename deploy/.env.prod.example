# Приклад оточення для продакшн-збірки. Скопіюй у deploy/.env.prod і заповни.
#
# Файл .env.prod у репозиторії НЕМАЄ й не буде: він у .gitignore. Секрети живуть на машині.

POSTGRES_USER=agentic
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=agentic

# Кілька ключів через кому. Кожен — окремий власник памʼяті.
API_KEYS=change-me-too

# Адреса, за якою сервіс відповідає. localhost -> внутрішній сертифікат Caddy.
SITE_ADDRESS=localhost
ACME_EMAIL=admin@example.com

# Сіль для похідного ідентифікатора власника. У prod обовʼязкова: без неї слабкий
# ключ відновлюється з трейсу словником за кілька спроб. Згенеруй свою:
#   python -c "import secrets; print(secrets.token_hex(16))"
OWNER_SALT=change-me-generate-your-own

# Порожні LLM_* означають підробку. Профіль prod відмовиться стартувати з нею, доки
# ALLOW_FAKE_LLM=1 не сказано явно — і стан показуватиме `provider: fake` без ключа.
# Для справжнього сервісу: прибери ALLOW_FAKE_LLM і заповни три рядки нижче.
ALLOW_FAKE_LLM=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

RATE_LIMIT_PER_MINUTE=30
BUDGET_USD_PER_DAY=5.00
