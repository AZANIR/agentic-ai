# Приклад оточення для продакшн-збірки. Скопіюй у deploy/.env.prod і заповни.
#
# Файл .env.prod у репозиторії НЕМАЄ й не буде: він у .gitignore. Секрети живуть на машині.

POSTGRES_USER=agentic
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=agentic

# Кілька ключів через кому. Кожен — окремий власник памʼяті.
API_KEYS=change-me-too

# Адреса, за якою сервіс відповідає. localhost -> внутрішній сертифікат Caddy.
SITE_ADDRESS=localhost
ACME_EMAIL=admin@example.com

# Порожні LLM_* означають підробку за сценарієм — сервіс підніметься й відповідатиме.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

RATE_LIMIT_PER_MINUTE=30
BUDGET_USD_PER_DAY=5.00
