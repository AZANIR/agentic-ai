# ---------------------------------------------------------------------------
# Скопіюй у .env і заповни. .env у git НЕ потрапляє (див. .gitignore).
#
#   cp .env.example .env
#
# Найважливіше: щоб пройти курс, тут можна нічого не міняти.
# Профіль local із порожнім LLM_API_KEY використовує детермінований FakeLLM,
# і всі перевірки (python scripts/check_all.py) проходять офлайн.
# ---------------------------------------------------------------------------

# local — усе в пам'яті, без мережі, детерміновано (за замовчуванням)
# prod  — Postgres, Redis, реальний LLM, метрики, трасування
APP_PROFILE=local


# --- LLM -------------------------------------------------------------------
# Один OpenAI-сумісний клієнт покриває всіх провайдерів (ADR-0003).
# Порожній LLM_API_KEY у профілі local => FakeLLM, мережі не буде взагалі.
#
# Groq (безкоштовний рівень, найшвидший старт):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Ollama (локально, без ключа — але LLM_API_KEY має бути непорожнім, будь-що):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1
#
# OpenAI (як у статтях-джерелах):
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Скільки кроків максимум робить агент, перш ніж здатися.
# Це не оптимізація — це захист від нескінченного циклу (стаття 1, режим відмови 1).
AGENT_MAX_STEPS=8


# --- Embeddings ------------------------------------------------------------
# hash      — детермінований, stdlib, нуль залежностей. Дефолт для local і перевірок.
# fastembed — справжні локальні ембеддинги на CPU (pip install -e ".[embed]")
# openai    — через той самий LLM_BASE_URL, якщо провайдер їх підтримує
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5


# --- Трасування ------------------------------------------------------------
# jsonl    — рядок на крок у TRACE_DIR (дефолт, працює завжди)
# langfuse — self-hosted Langfuse, профіль prod
TRACE_SINK=jsonl
TRACE_DIR=traces
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# --- Сховища (потрібні лише у профілі prod) --------------------------------
# Локальний docker compose підіймає рівно ці два сервіси:
#   docker compose -f deploy/docker-compose.yml up -d --wait
#
# УВАГА: тут 127.0.0.1, а НЕ localhost — і це не стилістика.
# Docker публікує порти лише на IPv4 (127.0.0.1:5432), а `localhost` на Windows
# і на багатьох Linux резолвиться СПЕРШУ в ::1 (IPv6). Клієнт іде на ::1,
# слухача там немає, і підключення або довго висить, або падає з незрозумілим
# таймаутом. Явна IPv4-адреса прибирає цю неоднозначність назавжди.
DATABASE_URL=postgresql://agentic:agentic@127.0.0.1:5432/agentic
REDIS_URL=redis://127.0.0.1:6379/0


# --- Сервіс і безпека (етапи 6 і 10) ---------------------------------------
# Кома-розділений список ключів, які приймає сервіс. Порожньо => auth вимкнено
# (припустимо лише локально; у профілі prod порожній список — це помилка старту).
API_KEYS=
CORS_ORIGINS=http://localhost:8000

# Rate limit: скільки запитів на хвилину на ключ і на IP.
RATE_LIMIT_PER_MINUTE=30

# Бюджетний запобіжник. Публічний ендпоінт, що ходить до LLM, — це відкритий
# гаманець; ці два ліміти закривають його ДО першого деплою, а не після рахунку.
BUDGET_USD_PER_SESSION=0.25
BUDGET_USD_PER_DAY=5.00

# Ліміти вводу — межа довіри, не оптимізація.
MAX_MESSAGE_CHARS=4000
MAX_AUDIO_SECONDS=30
